# ==============================================================================
# AI Tech Consultant - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit your real '.env' file or secret keys to source control!

# --- Anthropic Claude API Configuration ---
# Your Anthropic API key (required when real API calls are enabled)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Claude models to use
CLAUDE_PRIMARY_MODEL=claude-3-5-sonnet-20241022
CLAUDE_FAST_MODEL=claude-3-5-haiku-20241022

# --- Application Mode ---
# Set to 'true' to use safe, deterministic mock responses for testing without calling paid APIs.
# Set to 'false' to use the real Anthropic Claude API.
USE_MOCK_AI=true

# AI provider used when USE_MOCK_AI=false. Supported: claude, gemini.
AI_PROVIDER=claude
# Gemini configuration (only needed when AI_PROVIDER=gemini)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Optional explicit article JSON file. When unset, the API uses a completed
# knowledge_brain/data/full_articles.json crawl if present, otherwise sample data.
KNOWLEDGE_BRAIN_DATA_PATH=

# --- Vector Database & Storage ---
CHROMA_PERSIST_DIRECTORY=./knowledge_brain/data/chroma_db

# --- Application Settings ---
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8501
